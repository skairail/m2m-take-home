# Local defaults. Copy to .env for `npm start`.
# Docker Compose uses the same values if the variable is unset.

POSTGRES_USER=ingest
POSTGRES_PASSWORD=ingest
POSTGRES_DB=ingest
POSTGRES_PORT=5433

DATABASE_URL=postgres://ingest:ingest@127.0.0.1:5433/ingest
DEVICE_TOKEN=dev-shared-token
OFFLINE_THRESHOLD_SECONDS=300
PORT=3000
